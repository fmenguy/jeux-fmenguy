---
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>Arcade FM · Jeux & Expériences</title>
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE_WITH_YOUR_CF_TOKEN"}'></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;500;600&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #181b2e;
      --surface:   #232745;
      --surface2:  #2c3155;
      --border:    rgba(255,255,255,0.10);
      --gold:      #d4a017;
      --gold-dim:  #a07810;
      --violet:    #7c5cbf;
      --violet-glow: rgba(124,92,191,0.25);
      --text:      #e8e0d0;
      --text-strong: #f0e8d8;
      --text-strong-violet: #d8d0e8;
      --text-strong-wip: #f0e0c0;
      --muted:     #7a8090;
      --tag-full:  #1a2d1a;
      --tag-full-c:#4ade80;
      --tag-mini:  #1a1a2d;
      --tag-mini-c:#818cf8;
      --tag-soon-bg: #2d1f0a;
      --tag-soon-c:  #f59e0b;
      --grid-line: rgba(212,160,23,0.03);
      --card-shadow: 0 16px 40px rgba(0,0,0,0.5);
      --banner-fda:     radial-gradient(ellipse at 60% 40%, #4a3818 0%, #2a1d0a 100%);
      --banner-eryndor: radial-gradient(ellipse at 40% 60%, #2a2050 0%, #1a1430 100%);
      --banner-orbique: radial-gradient(ellipse at 50% 50%, #1a3552 0%, #0e1d30 100%);
      --banner-aelindra-base: #1a1828;
      --banner-aelindra-vignette: radial-gradient(120% 80% at 50% 50%, transparent 55%, rgba(0,0,0,0.45) 100%);
      --aelindra-name-grad: linear-gradient(180deg, #ecd190 0%, #d4b370 55%, #8a7340 100%);
      --aelindra-sub-c: #6a6276;
      --header-title-grad: linear-gradient(135deg, var(--gold) 0%, #f5d060 50%, var(--gold-dim) 100%);
    }

    [data-theme="light"] {
      --bg:        #f5f0eb;
      --surface:   #faf7f4;
      --surface2:  #ede7e0;
      --border:    rgba(120, 80, 40, 0.14);
      --gold:      #b8800f;
      --gold-dim:  #8a5f08;
      --violet:    #6a4ab0;
      --violet-glow: rgba(106,74,176,0.18);
      --text:      #2c1e10;
      --text-strong: #1a1208;
      --text-strong-violet: #2a1f4a;
      --text-strong-wip: #4a3208;
      --muted:     #6b5744;
      --tag-full:  #e2f4e2;
      --tag-full-c:#1e7a3a;
      --tag-mini:  #e7e7f5;
      --tag-mini-c:#4c52cc;
      --tag-soon-bg: #fbf0d8;
      --tag-soon-c:  #9a6608;
      --grid-line: rgba(184,128,15,0.05);
      --card-shadow: 0 16px 40px rgba(120,80,40,0.18);
      --banner-fda:     radial-gradient(ellipse at 60% 40%, #f5e4c2 0%, #e8d4a8 100%);
      --banner-eryndor: radial-gradient(ellipse at 40% 60%, #e8dcf2 0%, #d8cce8 100%);
      --banner-orbique: radial-gradient(ellipse at 50% 50%, #d8e8f4 0%, #c2d6e8 100%);
      --banner-aelindra-base: #ece2d4;
      --banner-aelindra-vignette: radial-gradient(120% 80% at 50% 50%, transparent 55%, rgba(120,80,40,0.10) 100%);
      --aelindra-name-grad: linear-gradient(180deg, #8a5f08 0%, #a07810 55%, #6a4a08 100%);
      --aelindra-sub-c: #8a7a60;
      --header-title-grad: linear-gradient(135deg, #b8800f 0%, #8a5f08 50%, #6a4808 100%);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      transition: background 0.3s ease, color 0.3s ease;
    }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    .header-left {
      position: absolute;
      top: 1.4rem;
      left: 1.8rem;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 11;
    }

    .site-logo {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .site-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 8px;
    }
    .site-logo:hover { transform: translateY(-2px); }

    .theme-toggle {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s, background 0.2s;
      flex-shrink: 0;
    }
    .theme-toggle:hover {
      color: var(--gold);
      border-color: var(--gold-dim);
      background: var(--surface2);
    }
    .theme-toggle__icon--light { display: none; }
    [data-theme="light"] .theme-toggle__icon--dark { display: none; }
    [data-theme="light"] .theme-toggle__icon--light { display: block; }

    header {
      position: relative; z-index: 10;
      padding: 3rem 2rem 2rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }

.header-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      letter-spacing: 0.12em;
      background: var(--header-title-grad);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
      margin-bottom: 0.6rem;
    }

    .header-sub {
      font-size: 0.9rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    main {
      position: relative; z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }

    .section-label {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .section-label:first-child { margin-top: 0; }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3.5rem;
    }

    .card-featured {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .card-featured:hover {
      transform: translateY(-4px);
      box-shadow: var(--card-shadow), 0 0 0 1px var(--gold-dim);
      border-color: var(--gold-dim);
    }

    .card-featured--violet:hover {
      box-shadow: var(--card-shadow), 0 0 0 1px var(--violet);
      border-color: var(--violet);
    }

    .card-featured::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .card-featured--violet::before {
      background: linear-gradient(90deg, transparent, var(--violet), transparent);
    }
    .card-featured:hover::before { opacity: 1; }

    .card-banner {
      height: 160px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cinzel', serif;
      font-size: 3rem;
      position: relative;
      overflow: hidden;
      background: var(--surface2);
    }

    .card-banner--fda {
      background: var(--banner-fda);
    }
    .card-banner--eryndor {
      background: var(--banner-eryndor);
    }

    .card-banner img {
      width: 100px; height: auto;
      opacity: 0.9;
      filter: drop-shadow(0 0 20px rgba(212,160,23,0.4));
    }

    .card-banner-icon {
      font-size: 4rem;
      filter: drop-shadow(0 0 12px currentColor);
    }
    .card-banner--fda .card-banner-icon { color: var(--gold); }
    .card-banner--eryndor .card-banner-icon { color: #a78bfa; }
    .card-banner--orbique .card-banner-icon { color: #38bdf8; }
    .card-banner--orbique { background: var(--banner-orbique); }
    .card-featured--cyan:hover { box-shadow: var(--card-shadow), 0 0 0 1px #38bdf8; border-color: #38bdf8; }
    .card-featured--cyan::before { background: linear-gradient(90deg, transparent, #38bdf8, transparent); }
    .card-featured--cyan .card-cta { color: #38bdf8; }

    .card-banner--aelindra {
      background:
        radial-gradient(120% 60% at 50% 0%, rgba(142,197,212,0.08) 0%, transparent 55%),
        radial-gradient(80% 50% at 50% 100%, rgba(212,179,112,0.10) 0%, transparent 60%),
        var(--banner-aelindra-base);
      position: relative;
    }
    .card-banner--aelindra::after {
      content: '';
      position: absolute; inset: 0;
      background: var(--banner-aelindra-vignette);
      pointer-events: none;
    }
    .aelindra-wordmark {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      position: relative;
      z-index: 1;
    }
    .aelindra-star {
      font-size: 0.85rem;
      color: var(--gold);
      opacity: 0.9;
      filter: drop-shadow(0 0 6px rgba(212,179,112,0.5));
      letter-spacing: 0;
    }
    .aelindra-name {
      font-family: 'Cinzel', serif;
      font-weight: 900;
      font-size: clamp(1.8rem, 4.5vw, 2.6rem);
      letter-spacing: 0.32em;
      padding-left: 0.32em;
      background: var(--aelindra-name-grad);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 22px rgba(212,179,112,0.25);
      line-height: 1;
    }
    .aelindra-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.62rem;
      letter-spacing: 0.45em;
      color: var(--aelindra-sub-c);
      padding-left: 0.45em;
    }
    .card-featured--aelindra:hover {
      box-shadow: var(--card-shadow), 0 0 0 1px var(--gold);
      border-color: var(--gold);
    }
    .card-featured--aelindra::before {
      background: linear-gradient(90deg, transparent, #d4b370, transparent);
    }
    .card-featured--aelindra .card-cta { color: #d4b370; }

    .card-body {
      padding: 1.4rem 1.5rem 1.6rem;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .card-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      width: fit-content;
    }
    .card-tag--full {
      background: var(--tag-full);
      color: var(--tag-full-c);
      border: 1px solid rgba(74,222,128,0.2);
    }
    .card-tag--mini {
      background: var(--tag-mini);
      color: var(--tag-mini-c);
      border: 1px solid rgba(129,140,248,0.2);
    }
    .card-tag--soon {
      background: var(--tag-soon-bg);
      color: var(--tag-soon-c);
      border: 1px solid rgba(245,158,11,0.25);
    }
    .card-tag::before { content: '●'; font-size: 0.5rem; }

    .card-title {
      font-family: 'Cinzel', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text-strong);
      line-height: 1.2;
    }

    .card-desc {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.6;
      flex: 1;
    }

    .card-cta {
      margin-top: 0.8rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: gap 0.2s;
    }
    .card-featured--violet .card-cta { color: #a78bfa; }
    .card-featured:hover .card-cta { gap: 0.7rem; }
    .card-cta::after { content: '→'; }

    .mini-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1rem;
    }

    .card-mini {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.2rem 1.3rem;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: transform 0.2s, border-color 0.2s, background 0.2s;
    }
    .card-mini:hover {
      transform: translateY(-2px);
      background: var(--surface2);
      border-color: rgba(129,140,248,0.35);
    }

    .card-wip {
      background: var(--surface);
      border: 1px dashed rgba(245,158,11,0.3);
      border-radius: 12px;
      padding: 1.4rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      text-decoration: none;
      color: inherit;
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }
    .card-wip:hover {
      transform: translateY(-3px);
      border-color: rgba(245,158,11,0.6);
      background: var(--surface2);
    }
    .card-wip-header {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }
    .card-wip-icon {
      font-size: 1.6rem;
      width: 42px; height: 42px;
      display: flex; align-items: center; justify-content: center;
      background: var(--surface2);
      border-radius: 8px;
      border: 1px solid rgba(245,158,11,0.2);
    }
    .card-wip-title {
      font-family: 'Cinzel', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-strong-wip);
    }
    .card-wip-subtitle {
      font-size: 0.7rem;
      color: #f59e0b;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .card-wip-desc {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.6;
    }
    .card-wip-refs {
      font-size: 0.72rem;
      color: var(--muted);
      font-style: italic;
      padding-top: 0.4rem;
      border-top: 1px solid var(--border);
      margin-top: 0.3rem;
    }

    .dev-card {
      background: var(--surface);
      border: 1px dashed rgba(245,158,11,0.35);
      border-radius: 14px;
      padding: 1.8rem 1.8rem 1.6rem;
      margin-top: 0.5rem;
    }
    .dev-card-head {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-bottom: 0.9rem;
    }
    .dev-card-title {
      font-family: 'Cinzel', serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-strong-wip);
      letter-spacing: 0.04em;
    }
    .dev-card-status {
      font-size: 0.7rem;
      color: #f59e0b;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .dev-card p {
      font-size: 0.9rem;
      line-height: 1.65;
      color: var(--text);
      margin-bottom: 0.8rem;
    }
    .dev-card a.inline {
      color: var(--gold);
      text-decoration: none;
      border-bottom: 1px solid rgba(212,160,23,0.3);
    }
    .dev-card a.inline:hover { border-color: var(--gold); }

    .card-cta-link {
      display: inline-block;
      margin-top: 1.2rem;
      text-decoration: none;
    }
    .card-cta-link:hover .card-cta { gap: 0.7rem; }

    /* === Boutons Jouer thématiques par jeu === */
    .btn-game {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      align-self: flex-start;
      margin-top: 0.9rem;
      padding: 0.55rem 1.05rem;
      font-family: 'Cinzel', serif;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border-radius: 8px;
      border: 1px solid transparent;
      background-clip: padding-box;
      transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .btn-game::after { content: '→'; transition: transform 0.2s ease; }
    a:hover .btn-game::after,
    .card-cta-link:hover .btn-game::after { transform: translateX(3px); }
    a:hover .btn-game { transform: translateY(-1px); }

    /* FDA · forge / or / braise */
    .btn-game--fda {
      color: #f5d97a;
      background: linear-gradient(135deg, rgba(212,160,23,0.22), rgba(140,80,20,0.12));
      border-color: rgba(212,160,23,0.50);
      text-shadow: 0 0 8px rgba(212,160,23,0.35);
    }
    a:hover .btn-game--fda {
      border-color: #d4a017;
      box-shadow: 0 0 20px rgba(212,160,23,0.30), inset 0 0 14px rgba(212,160,23,0.10);
    }
    [data-theme="light"] .btn-game--fda {
      color: #6a4808;
      background: linear-gradient(135deg, rgba(212,160,23,0.18), rgba(184,128,15,0.10));
      border-color: rgba(184,128,15,0.55);
      text-shadow: none;
    }
    [data-theme="light"] a:hover .btn-game--fda {
      box-shadow: 0 0 18px rgba(184,128,15,0.22);
    }

    /* Orbique · cyan luminescent */
    .btn-game--orbique {
      color: #7fdcff;
      background: linear-gradient(135deg, rgba(56,189,248,0.18), rgba(30,100,180,0.10));
      border-color: rgba(56,189,248,0.50);
      text-shadow: 0 0 8px rgba(56,189,248,0.35);
    }
    a:hover .btn-game--orbique {
      border-color: #38bdf8;
      box-shadow: 0 0 20px rgba(56,189,248,0.30), inset 0 0 14px rgba(56,189,248,0.10);
    }
    [data-theme="light"] .btn-game--orbique {
      color: #0c5b8a;
      background: linear-gradient(135deg, rgba(56,189,248,0.16), rgba(56,140,200,0.08));
      border-color: rgba(56,140,200,0.55);
      text-shadow: none;
    }
    [data-theme="light"] a:hover .btn-game--orbique {
      box-shadow: 0 0 18px rgba(56,140,200,0.22);
    }

    /* Aelindra · sable, cuivre, lampe à huile */
    .btn-game--aelindra {
      color: #e8c980;
      background: linear-gradient(135deg, rgba(212,179,112,0.22), rgba(120,80,40,0.12));
      border-color: rgba(212,179,112,0.50);
      text-shadow: 0 0 8px rgba(212,179,112,0.30);
    }
    a:hover .btn-game--aelindra {
      border-color: #d4b370;
      box-shadow: 0 0 18px rgba(212,179,112,0.30);
    }
    [data-theme="light"] .btn-game--aelindra {
      color: #7a5018;
      background: linear-gradient(135deg, rgba(212,179,112,0.20), rgba(160,120,60,0.10));
      border-color: rgba(160,120,60,0.55);
      text-shadow: none;
    }

    /* Zentel · arcane / violet */
    .btn-game--zentel {
      color: #c4a4ff;
      background: linear-gradient(135deg, rgba(124,92,191,0.22), rgba(70,40,140,0.12));
      border-color: rgba(168,124,255,0.50);
      text-shadow: 0 0 8px rgba(168,124,255,0.40);
    }
    a:hover .btn-game--zentel {
      border-color: #a78bfa;
      box-shadow: 0 0 20px rgba(124,92,191,0.32);
    }
    [data-theme="light"] .btn-game--zentel {
      color: #4a2a90;
      background: linear-gradient(135deg, rgba(124,92,191,0.16), rgba(90,60,160,0.08));
      border-color: rgba(106,74,176,0.55);
      text-shadow: none;
    }

    /* EcoSim · feuille / nature */
    .btn-game--ecosim {
      color: #86efac;
      background: linear-gradient(135deg, rgba(74,222,128,0.18), rgba(20,90,40,0.10));
      border-color: rgba(74,222,128,0.50);
      text-shadow: 0 0 8px rgba(74,222,128,0.30);
    }
    a:hover .btn-game--ecosim {
      border-color: #4ade80;
      box-shadow: 0 0 18px rgba(74,222,128,0.30);
    }
    [data-theme="light"] .btn-game--ecosim {
      color: #1e6a35;
      background: linear-gradient(135deg, rgba(74,222,128,0.18), rgba(30,122,58,0.10));
      border-color: rgba(30,122,58,0.55);
      text-shadow: none;
    }

    /* Conway · grille cellulaire monospace */
    .btn-game--conway {
      color: #e8e0d0;
      font-family: 'JetBrains Mono', 'Consolas', monospace;
      letter-spacing: 0.10em;
      background-color: rgba(255,255,255,0.04);
      background-image:
        linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
      background-size: 6px 6px, 6px 6px;
      border-color: rgba(232,224,208,0.35);
    }
    a:hover .btn-game--conway {
      border-color: #e8e0d0;
      box-shadow: 0 0 14px rgba(255,255,255,0.18);
    }
    [data-theme="light"] .btn-game--conway {
      color: #2a1e10;
      background-color: rgba(0,0,0,0.04);
      background-image:
        linear-gradient(rgba(0,0,0,0.10) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,0,0,0.10) 1px, transparent 1px);
      border-color: rgba(0,0,0,0.30);
    }

    /* Eryndor · duel violet × or */
    .btn-game--eryndor {
      color: #f0d97a;
      background: linear-gradient(90deg, rgba(124,79,208,0.25) 0%, rgba(212,160,23,0.22) 100%);
      border-color: rgba(180,130,200,0.50);
      text-shadow: 0 0 8px rgba(212,160,23,0.30);
    }
    a:hover .btn-game--eryndor {
      border-color: #b88be5;
      box-shadow: 0 0 16px rgba(124,79,208,0.30), 0 0 10px rgba(212,160,23,0.20);
    }
    [data-theme="light"] .btn-game--eryndor {
      color: #5a2e90;
      background: linear-gradient(90deg, rgba(124,79,208,0.14) 0%, rgba(184,128,15,0.14) 100%);
      border-color: rgba(124,79,208,0.50);
      text-shadow: none;
    }

    /* Strates · roches stratifiées */
    .btn-game--strates {
      color: #e0cda0;
      background-color: rgba(180,140,90,0.18);
      background-image:
        repeating-linear-gradient(180deg,
          transparent 0,
          transparent 4px,
          rgba(255,255,255,0.05) 4px,
          rgba(255,255,255,0.05) 5px);
      border-color: rgba(200,170,120,0.50);
      text-shadow: 0 0 8px rgba(212,160,90,0.30);
    }
    .card-cta-link:hover .btn-game--strates {
      border-color: #c8a878;
      box-shadow: 0 0 16px rgba(180,140,90,0.30);
    }
    [data-theme="light"] .btn-game--strates {
      color: #6a4818;
      background-color: rgba(180,140,90,0.16);
      background-image:
        repeating-linear-gradient(180deg,
          transparent 0,
          transparent 4px,
          rgba(120,80,40,0.10) 4px,
          rgba(120,80,40,0.10) 5px);
      border-color: rgba(160,120,60,0.55);
      text-shadow: none;
    }

    .dev-progress {
      margin-top: 1.4rem;
      padding-top: 1.2rem;
      border-top: 1px solid var(--border);
    }
    .dev-progress-label {
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.8rem;
    }
    .ages {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.4rem;
      margin-bottom: 0.9rem;
      max-width: 420px;
    }
    .age {
      aspect-ratio: 1;
      border-radius: 6px;
      background: var(--surface2);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cinzel', serif;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--muted);
      position: relative;
    }
    .age.done {
      background: rgba(74,222,128,0.08);
      border-color: rgba(74,222,128,0.4);
      color: #4ade80;
    }
    .age.wip {
      background: rgba(245,158,11,0.1);
      border-color: rgba(245,158,11,0.5);
      color: #f59e0b;
    }
    .age.wip::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 7px;
      border: 1px solid rgba(245,158,11,0.3);
      animation: agepulse 2s ease-in-out infinite;
    }
    @keyframes agepulse {
      0%, 100% { opacity: 0.3; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(1.05); }
    }
    .dev-progress-meta {
      font-size: 0.8rem;
      color: var(--muted);
    }
    .dev-progress-meta strong {
      color: var(--text);
      font-weight: 600;
    }

    /* === Carte dev "Grimoire Stellaire" pour Achrogemme === */
    .dev-card--elf {
      background:
        radial-gradient(ellipse at 30% 0%, rgba(201,162,39,0.08) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 100%, rgba(45,122,79,0.08) 0%, transparent 55%),
        var(--surface);
      border: 1px solid rgba(201,162,39,0.30);
      border-radius: 14px;
      position: relative;
      overflow: hidden;
    }
    .dev-card--elf::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(201,162,39,0.5), transparent);
    }
    .dev-card--elf .dev-card-title {
      background: linear-gradient(135deg, #f0d97a 0%, #c9a227 50%, #7a600f 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .dev-card--elf .dev-card-status {
      color: #9b6ee8;
    }
    .dev-card--elf a.inline {
      color: #e8c547;
      border-bottom-color: rgba(201,162,39,0.4);
    }
    .dev-card--elf a.inline:hover { border-color: #e8c547; }

    .elf-actions {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-top: 1.2rem;
      padding-top: 1.1rem;
      border-top: 1px solid rgba(201,162,39,0.18);
    }
    .elf-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.1rem;
      font-family: 'Cinzel', serif;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-decoration: none;
      border-radius: 6px;
      transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      position: relative;
    }
    .elf-btn--play {
      color: var(--gold);
      border: 1px solid rgba(212,160,23,0.35);
      background: rgba(212,160,23,0.05);
      padding: 0.6rem 1.1rem;
      margin: 0;
    }
    .elf-btn--play .card-cta { margin: 0; color: var(--gold); }
    .elf-btn--play:hover {
      border-color: var(--gold);
      box-shadow: 0 0 16px rgba(212,160,23,0.18);
    }
    .elf-btn--lore {
      color: #f0d97a;
      background:
        linear-gradient(135deg, rgba(124,79,208,0.18) 0%, rgba(201,162,39,0.12) 60%, rgba(45,122,79,0.16) 100%);
      border: 1px solid rgba(201,162,39,0.45);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.06),
        0 4px 16px rgba(0,0,0,0.4);
    }
    .elf-btn--lore::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 6px;
      background: linear-gradient(90deg, transparent, rgba(232,197,71,0.08), transparent);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .elf-btn--lore:hover {
      transform: translateY(-1px);
      border-color: #e8c547;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.08),
        0 6px 24px rgba(124,79,208,0.25),
        0 0 20px rgba(201,162,39,0.20);
    }
    .elf-btn--lore:hover::before { opacity: 1; }
    .elf-btn-icon {
      font-size: 0.95rem;
      color: #c45fa0;
      filter: drop-shadow(0 0 4px rgba(196,95,160,0.6));
    }
    .elf-btn-label {
      font-family: 'Cinzel Decorative', 'Cinzel', serif;
      font-weight: 700;
    }
    .elf-btn-arrow {
      font-size: 0.9rem;
      color: #9b6ee8;
      transition: transform 0.2s ease;
    }
    .elf-btn--lore:hover .elf-btn-arrow { transform: translateX(3px); }

    [data-theme="light"] .elf-btn--play {
      color: var(--gold-dim);
      border-color: rgba(184,128,15,0.45);
      background: rgba(212,160,23,0.12);
    }
    [data-theme="light"] .elf-btn--play .card-cta { color: var(--gold-dim); }
    [data-theme="light"] .elf-btn--play:hover {
      border-color: var(--gold);
      background: rgba(212,160,23,0.18);
      box-shadow: 0 0 14px rgba(184,128,15,0.18);
    }
    [data-theme="light"] .elf-btn--lore {
      color: #5a3a8a;
      background:
        linear-gradient(135deg, rgba(124,79,208,0.10) 0%, rgba(201,162,39,0.10) 60%, rgba(45,122,79,0.10) 100%);
      border-color: rgba(124,79,208,0.40);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.5),
        0 2px 8px rgba(120,80,40,0.10);
    }
    [data-theme="light"] .elf-btn--lore:hover {
      border-color: #7c4fd0;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.6),
        0 6px 18px rgba(124,79,208,0.20);
    }
    [data-theme="light"] .elf-btn-icon { color: #a8408a; filter: none; }
    [data-theme="light"] .elf-btn-arrow { color: #7c4fd0; }

    .card-mini-header {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .card-mini-icon {
      font-size: 1.4rem;
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      background: var(--surface2);
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .card-mini-title {
      font-family: 'Cinzel', serif;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-strong-violet);
    }

    .card-mini-desc {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.5;
      flex: 1;
    }

    footer {
      position: relative; z-index: 1;
      text-align: center;
      padding: 2rem;
      border-top: 1px solid var(--border);
      font-size: 0.78rem;
      color: var(--muted);
    }
    footer a { color: var(--gold); text-decoration: none; }
    footer a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      header { padding: 3.5rem 1rem 1.5rem; }
      .site-back { top: 1rem; left: 1rem; }
      main { padding: 2rem 1rem 4rem; }
      .card-banner { height: 120px; }
    }
  </style>
</head>
<body>

<header>
  <div class="header-left">
    <a class="site-logo" href="https://fmenguy.fr" aria-label="Retour sur fmenguy.fr" title="Retour sur fmenguy.fr">
      <img src="/logo.png" alt="FM" width="42" height="42" />
    </a>
    <button class="theme-toggle" id="theme-toggle" aria-label="Changer de thème" title="Changer de thème">
      <svg class="theme-toggle__icon theme-toggle__icon--dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v1m0 16v1m-8-9H3m18 0h-1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707"/>
        <circle cx="12" cy="12" r="4"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
  <div class="header-title">Arcade FM</div>
  <div class="header-sub">Jeux &amp; expériences web</div>
</header>

<main>

  <div class="section-label">Jeux complets</div>
  <div class="featured-grid">

    <a class="card-featured" href="/fda/">
      <div class="card-banner card-banner--fda">
        <img src="/fda/assets/fda.webp" alt="Forge des Âges" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <span class="card-banner-icon" style="display:none">⚒</span>
      </div>
      <div class="card-body">
        <span class="card-tag card-tag--full">Jeu complet</span>
        <div class="card-title">Forge des Âges</div>
        <div class="card-desc">Jeu de gestion médiéval au tour par tour. Gérez vos ressources, explorez la carte, forgez votre empire. Avec ambiance sonore et mode mobile.</div>
        <span class="btn-game btn-game--fda">Jouer</span>
      </div>
    </a>

    <a class="card-featured card-featured--cyan" href="/orbique/">
      <div class="card-banner card-banner--orbique">
        <span class="card-banner-icon">🔵</span>
      </div>
      <div class="card-body">
        <span class="card-tag card-tag--full">Jeu complet</span>
        <div class="card-title">Orbique</div>
        <div class="card-desc">Jeu d'exploration en salles thématiques. Particules, textures, puzzles et tutoriel intégré pour une expérience visuelle immersive.</div>
        <span class="btn-game btn-game--orbique">Jouer</span>
      </div>
    </a>
  </div>

  <div class="section-label">Mini-jeux</div>
  <div class="mini-grid">

    <a class="card-mini" href="/aelindra/">
      <div class="card-mini-header">
        <span class="card-mini-icon">⚔</span>
        <span class="card-mini-title">Aelindra</span>
      </div>
      <div class="card-mini-desc">POC d'un RPG tactique tour par tour pensé mobile. Constituez votre équipe, explorez des donjons, gacha et équipement. Installable comme app Android (PWA).</div>
      <span class="btn-game btn-game--aelindra">Jouer</span>
    </a>

    <a class="card-mini" href="/zentel/">
      <div class="card-mini-header">
        <span class="card-mini-icon">🔮</span>
        <span class="card-mini-title">Zentel</span>
      </div>
      <div class="card-mini-desc">Expérimentation visuelle interactive générée avec p5.js.</div>
      <span class="btn-game btn-game--zentel">Jouer</span>
    </a>

    <a class="card-mini" href="/ecosim/ecosystem.html">
      <div class="card-mini-header">
        <span class="card-mini-icon">🌿</span>
        <span class="card-mini-title">EcoSim</span>
      </div>
      <div class="card-mini-desc">Simulation d'écosystème. Créatures, nourriture, prédateurs, observez l'équilibre se construire.</div>
      <span class="btn-game btn-game--ecosim">Jouer</span>
    </a>

    <a class="card-mini" href="/conway/">
      <div class="card-mini-header">
        <span class="card-mini-icon">🧬</span>
        <span class="card-mini-title">Jeu de la Vie</span>
      </div>
      <div class="card-mini-desc">Automate cellulaire de Conway. Tracez des patterns et regardez la vie émerger.</div>
      <span class="btn-game btn-game--conway">Jouer</span>
    </a>

    <a class="card-mini" href="/eryndor/">
      <div class="card-mini-header">
        <span class="card-mini-icon">⚔</span>
        <span class="card-mini-title">Eryndor : Duel d'IA</span>
      </div>
      <div class="card-mini-desc">Simulation fantasy en mode spectateur. Deux agents IA s'affrontent à la tête des humains et des elfes.</div>
      <span class="btn-game btn-game--eryndor">Jouer</span>
    </a>

  </div>

  <div class="section-label">Jeux en cours de développement</div>

  <div class="dev-card dev-card--elf">
    <div class="dev-card-head">
      <span class="dev-card-title">Achrogemme</span>
      <span class="dev-card-status">En développement</span>
    </div>
    <p>
      Duel d'Achronia, solo contre Sylvie, tiré du <a class="inline" href="https://elfes.fmenguy.fr">roman illustré de l'Aventure des Sœurs Elfes</a>. Trois Marches gardent les frontières du royaume : la Sylvestre des bois, l'Arcanique des plaines, le Rempart des forteresses. Sur chacune, jusqu'à trois unités par côté (front · milieu · arrière) où les volontés se cristallisent en Gemmes.
    </p>
    <p>
      Les Sylvestres tirent en direct, les Arcaniques soignent, les Guerriers du Rempart encaissent. Active les synergies de faction à 2, 3 ou 4 unités d'un même peuple, et abats le Champion adverse avant qu'il ne fasse tomber le tien.
    </p>

    <div class="elf-actions">
      <a class="card-cta-link elf-btn elf-btn--play" href="/achrogemme/">
        <span class="card-cta">Jouer</span>
      </a>
      <a class="elf-btn elf-btn--lore" href="https://elfes.fmenguy.fr" target="_blank" rel="noopener">
        <span class="elf-btn-icon">✦</span>
        <span class="elf-btn-label">Découvrir le roman</span>
        <span class="elf-btn-arrow">→</span>
      </a>
    </div>
  </div>

  <div class="dev-card">
    <div class="dev-card-head">
      <span class="dev-card-title">Strates</span>
      <span class="dev-card-status">En développement</span>
    </div>
    <p>
      Jeu de simulation voxel inspiré de <a class="inline" href="/fda/">Forge des Âges</a>. Une colonie débarque sur une île et traverse sept âges de civilisation, de la pierre jusqu'à l'espace.
    </p>
    <p>
      Le but du joueur, explorer le monde, accompagner ses colons, et atteindre le dernier âge.
    </p>

    <div class="dev-progress">
      <div class="dev-progress-label">Avancement</div>
      <div class="ages">
        <div class="age done" title="Âge 1, Pierre, finalisé">I</div>
        <div class="age wip" title="Âge 2, en cours">II</div>
        <div class="age" title="Âge 3">III</div>
        <div class="age" title="Âge 4">IV</div>
        <div class="age" title="Âge 5">V</div>
        <div class="age" title="Âge 6">VI</div>
        <div class="age" title="Âge 7">VII</div>
      </div>
      <p class="dev-progress-meta">
        Au <strong>10 mai 2026</strong>, deux mois de travail sur le projet. Âge 1 (Pierre) finalisé, âge 2 en cours.
      </p>
    </div>
    <a class="card-cta-link" href="https://strates.fmenguy.fr">
      <span class="btn-game btn-game--strates">Jouer</span>
    </a>
  </div>

</main>

<footer>
  <p>Des projets de <a href="https://fmenguy.fr">François Menguy</a></p>
</footer>

<script is:inline>
  (function() {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  })();
</script>

</body>
</html>
