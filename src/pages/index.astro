---
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>Arcade FM · Jeux & Expériences</title>
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE_WITH_YOUR_CF_TOKEN"}'></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;500;600&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #181b2e;
      --surface:   #232745;
      --surface2:  #2c3155;
      --border:    rgba(255,255,255,0.10);
      --gold:      #d4a017;
      --gold-dim:  #a07810;
      --violet:    #7c5cbf;
      --text:      #e8e0d0;
      --text-strong: #f0e8d8;
      --text-strong-violet: #d8d0e8;
      --muted:     #7a8090;
      --tag-full:  #1a2d1a;
      --tag-full-c:#4ade80;
      --grid-line: rgba(212,160,23,0.03);
      --card-shadow: 0 14px 34px rgba(0,0,0,0.5);
      --banner-fda:     radial-gradient(ellipse at 50% 45%, #2e2416 0%, #1b1610 100%);
      --banner-orbique: radial-gradient(ellipse at 50% 50%, #1a3552 0%, #0e1d30 100%);
      --banner-achro:
        radial-gradient(ellipse at 25% 20%, rgba(124,79,208,0.45) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 90%, rgba(45,122,79,0.35) 0%, transparent 55%),
        linear-gradient(160deg, #241a3c 0%, #17122a 100%);
      --header-title-grad: linear-gradient(135deg, var(--gold) 0%, #f5d060 50%, var(--gold-dim) 100%);
    }

    [data-theme="light"] {
      --bg:        #f5f0eb;
      --surface:   #faf7f4;
      --surface2:  #ede7e0;
      --border:    rgba(120, 80, 40, 0.14);
      --gold:      #b8800f;
      --gold-dim:  #8a5f08;
      --violet:    #6a4ab0;
      --text:      #2c1e10;
      --text-strong: #1a1208;
      --text-strong-violet: #2a1f4a;
      --muted:     #6b5744;
      --tag-full:  #e2f4e2;
      --tag-full-c:#1e7a3a;
      --grid-line: rgba(184,128,15,0.05);
      --card-shadow: 0 14px 34px rgba(120,80,40,0.18);
      --banner-orbique: radial-gradient(ellipse at 50% 50%, #d8e8f4 0%, #c2d6e8 100%);
      --banner-achro:
        radial-gradient(ellipse at 25% 20%, rgba(124,79,208,0.22) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 90%, rgba(45,122,79,0.18) 0%, transparent 55%),
        linear-gradient(160deg, #ece4f4 0%, #e0d6ec 100%);
      --header-title-grad: linear-gradient(135deg, #b8800f 0%, #8a5f08 50%, #6a4808 100%);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      min-height: 100dvh;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      transition: background 0.3s ease, color 0.3s ease;
    }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    /* === Barre du haut : logo, thème, titre, crédit sur une seule ligne === */
    .topbar {
      position: relative; z-index: 10;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem clamp(1rem, 2vw, 2rem);
      border-bottom: 1px solid var(--border);
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .site-logo {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .site-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 8px;
    }
    .site-logo:hover { transform: translateY(-2px); }

    .theme-toggle {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s, background 0.2s;
      flex-shrink: 0;
    }
    .theme-toggle:hover {
      color: var(--gold);
      border-color: var(--gold-dim);
      background: var(--surface2);
    }
    .theme-toggle__icon--light { display: none; }
    [data-theme="light"] .theme-toggle__icon--dark { display: none; }
    [data-theme="light"] .theme-toggle__icon--light { display: block; }

    .topbar-brand {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      flex-wrap: wrap;
      min-width: 0;
    }
    .header-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.35rem, 2vw, 1.8rem);
      font-weight: 900;
      letter-spacing: 0.12em;
      background: var(--header-title-grad);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
    }
    .header-sub {
      font-size: 0.7rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    .topbar-credit {
      margin-left: auto;
      font-size: 0.75rem;
      color: var(--muted);
      white-space: nowrap;
    }
    .topbar-credit a { color: var(--gold); text-decoration: none; }
    .topbar-credit a:hover { text-decoration: underline; }

    /* === Grille du tableau de bord ===
       Mobile et tablette : les zones s'empilent.
       Desktop (>= 1100px) : grille 12 colonnes qui remplit la hauteur de l'écran,
       les jeux à la une en haut, jeux complets et mini-jeux en bas. */
    .dash {
      position: relative; z-index: 1;
      flex: 1;
      width: 100%;
      max-width: 1920px;
      margin: 0 auto;
      padding: 1.5rem 1rem 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .zone {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .une-grid {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .section-label {
      font-family: 'Cinzel', serif;
      font-size: 0.66rem;
      font-weight: 400;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.7rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .card-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.18rem 0.55rem;
      border-radius: 4px;
      width: fit-content;
      white-space: nowrap;
    }
    .card-tag--full {
      background: var(--tag-full);
      color: var(--tag-full-c);
      border: 1px solid rgba(74,222,128,0.2);
    }
    .card-tag::before { content: '●'; font-size: 0.45rem; }

    a.inline {
      text-decoration: none;
      border-bottom: 1px solid currentColor;
    }

    .panel {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      min-width: 0;
    }
    .panel-head {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      flex-wrap: wrap;
    }
    .panel-title {
      font-family: 'Cinzel', serif;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .panel-status {
      font-size: 0.64rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .panel-desc {
      font-size: 0.86rem;
      line-height: 1.6;
    }

    /* Capture cliquable qui sert de bouton Jouer, l'image remplit toute la hauteur dispo */
    .shot {
      position: relative;
      display: block;
      min-height: 200px;
      overflow: hidden;
      text-decoration: none;
    }
    .shot img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .shot:hover img { transform: scale(1.03); }
    .shot-play {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 2.4rem 1.1rem 0.95rem;
      font-family: 'Cinzel', serif;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.1em;
    }
    .shot-play-arrow {
      margin-left: auto;
      transition: transform 0.2s ease;
    }
    .shot:hover .shot-play-arrow { transform: translateX(4px); }
    .shot-badge {
      position: absolute;
      top: 0.8rem;
      right: 0.8rem;
      padding: 0.18rem 0.6rem;
      border-radius: 999px;
      font-family: 'Cinzel', serif;
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      border: 1px solid rgba(255,255,255,0.35);
    }

    /* === Strates : nuit voxel, strates de roche, lueur de feu de camp === */
    .panel--strates {
      display: grid;
      grid-template-columns: 1fr;
      border: 1px solid rgba(200,170,120,0.35);
      background:
        radial-gradient(ellipse at 75% 108%, rgba(245,158,11,0.20) 0%, rgba(245,158,11,0.08) 22%, transparent 50%),
        repeating-linear-gradient(180deg,
          rgba(255,255,255,0.035) 0px,
          rgba(255,255,255,0.035) 2px,
          transparent 2px,
          transparent 12px),
        linear-gradient(180deg, #0b0f22 0%, #131a34 45%, #1c2440 75%, #232a42 100%);
    }
    .panel--strates::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        radial-gradient(1px 1px at 62% 12%, rgba(255,255,255,0.85) 0, transparent 60%),
        radial-gradient(1px 1px at 70% 22%, rgba(255,255,255,0.6) 0, transparent 60%),
        radial-gradient(1px 1px at 82% 10%, rgba(255,255,255,0.75) 0, transparent 60%),
        radial-gradient(1px 1px at 88% 26%, rgba(255,255,255,0.55) 0, transparent 60%),
        radial-gradient(1px 1px at 94% 14%, rgba(255,255,255,0.8) 0, transparent 60%),
        radial-gradient(1px 1px at 76% 6%, rgba(255,255,255,0.65) 0, transparent 60%);
    }
    .panel--strates::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      background:
        linear-gradient(90deg, transparent, rgba(212,160,23,0.5), transparent) top left / 100% 2px no-repeat,
        linear-gradient(135deg, rgba(212,160,23,0.45) 0 10px, transparent 10px) top left / 20px 20px no-repeat,
        linear-gradient(-45deg, rgba(212,160,23,0.45) 0 10px, transparent 10px) bottom right / 20px 20px no-repeat;
    }
    .panel--strates .shot {
      border-bottom: 1px solid rgba(212,160,23,0.28);
    }
    .panel--strates .shot img { object-position: center 42%; }
    .panel--strates .shot-play {
      color: #f7d98a;
      background: linear-gradient(180deg, transparent, rgba(8,11,26,0.92));
    }
    .panel--strates .shot-badge {
      color: #1a1206;
      background: linear-gradient(135deg, #f6dfa4 0%, #d4a017 100%);
      box-shadow: 0 2px 10px rgba(212,160,23,0.45);
    }
    .strates-info {
      position: relative;
      z-index: 1;
      padding: 1.2rem 1.3rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      min-width: 0;
    }
    .panel--strates .panel-title {
      background-image: linear-gradient(135deg, #f0dca0 0%, #d4a017 55%, #8a6420 100%);
    }
    .panel--strates .panel-status { color: #f59e0b; }
    .panel--strates .panel-desc { color: #d6ddef; }
    .panel--strates a.inline { color: #f0c96a; }
    .card-tag--strates {
      background: rgba(212,160,23,0.14);
      color: #eab84d;
      border: 1px solid rgba(212,160,23,0.35);
    }

    .dev-progress-label {
      font-family: 'Cinzel', serif;
      font-size: 0.62rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(214,221,239,0.55);
      margin-bottom: 0.45rem;
    }
    .ages {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 0.3rem;
      margin-bottom: 0.45rem;
    }
    .age {
      height: 30px;
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      font-weight: 700;
      position: relative;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.14);
      color: rgba(214,221,239,0.45);
    }
    .age.done {
      background: rgba(74,222,128,0.08);
      border-color: rgba(74,222,128,0.4);
      color: #4ade80;
    }
    .age.wip {
      background: rgba(245,158,11,0.1);
      border-color: rgba(245,158,11,0.5);
      color: #f59e0b;
    }
    .age.wip::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 6px;
      border: 1px solid rgba(245,158,11,0.3);
      animation: agepulse 2s ease-in-out infinite;
    }
    @keyframes agepulse {
      0%, 100% { opacity: 0.3; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(1.05); }
    }
    .dev-progress-meta {
      font-size: 0.76rem;
      line-height: 1.5;
      color: rgba(214,221,239,0.72);
    }

    .strates-actions {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding-top: 0.85rem;
      border-top: 1px solid rgba(212,160,23,0.18);
    }
    .strates-download {
      display: flex;
      align-items: center;
      gap: 0.4rem 0.9rem;
      flex-wrap: wrap;
    }
    .strates-install {
      font-size: 0.74rem;
      color: rgba(214,221,239,0.7);
    }
    .strates-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .strates-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.36rem 0.7rem;
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-decoration: none;
      border-radius: 6px;
      white-space: nowrap;
      transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }
    .strates-btn:hover { transform: translateY(-1px); }
    .strates-btn--download {
      padding: 0.5rem 0.95rem;
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      color: #1b1914;
      background: #f0c96a;
      border: 1px solid #f0c96a;
    }
    .strates-btn--download:hover { background: #f7d98a; }
    .strates-btn--changelog {
      color: #4ade80;
      border: 1px solid rgba(74,222,128,0.35);
      background: rgba(74,222,128,0.06);
    }
    .strates-btn--changelog:hover { border-color: #4ade80; box-shadow: 0 0 14px rgba(74,222,128,0.22); }
    .strates-btn--kanban {
      color: #7cc4ff;
      border: 1px solid rgba(124,196,255,0.35);
      background: rgba(124,196,255,0.06);
    }
    .strates-btn--kanban:hover { border-color: #7cc4ff; box-shadow: 0 0 14px rgba(124,196,255,0.22); }
    .strates-btn--agents {
      color: #fb923c;
      border: 1px solid rgba(251,146,60,0.4);
      background: rgba(251,146,60,0.07);
    }
    .strates-btn--agents:hover { border-color: #fb923c; box-shadow: 0 0 14px rgba(251,146,60,0.24); }
    .strates-btn--poc {
      color: #f0c96a;
      border: 1px dashed rgba(212,160,23,0.5);
      background: rgba(212,160,23,0.06);
    }
    .strates-btn--poc:hover { border-color: #f0c96a; box-shadow: 0 0 14px rgba(212,160,23,0.22); }

    /* === Bathyrêve : abysses bleu canard, cuivre des structures, bulles === */
    .panel--bathy {
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(127,214,232,0.30);
      background:
        radial-gradient(circle at 88% 78%, rgba(160,230,245,0.16) 0 5px, transparent 6px),
        radial-gradient(circle at 93% 70%, rgba(160,230,245,0.12) 0 3px, transparent 4px),
        radial-gradient(circle at 84% 64%, rgba(160,230,245,0.10) 0 2px, transparent 3px),
        radial-gradient(ellipse at 50% 0%, rgba(127,214,232,0.14) 0%, transparent 60%),
        linear-gradient(180deg, #0f3a4e 0%, #0a2b3b 55%, #061b27 100%);
    }
    .panel--bathy::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      background: linear-gradient(90deg, transparent, rgba(232,149,90,0.55), transparent) top left / 100% 2px no-repeat;
    }
    .panel--bathy .shot {
      flex: 1;
      border-bottom: 1px solid rgba(127,214,232,0.25);
    }
    .panel--bathy .shot img { object-position: center 48%; }
    .panel--bathy .shot-play {
      color: #ffd9b8;
      background: linear-gradient(180deg, transparent, rgba(4,20,30,0.92));
    }
    .panel--bathy .shot-badge {
      color: #062030;
      background: linear-gradient(135deg, #c8f2fb 0%, #7fd6e8 100%);
      box-shadow: 0 2px 10px rgba(127,214,232,0.40);
    }
    .bathy-info {
      padding: 1rem 1.3rem 1.2rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .panel--bathy .panel-title {
      background-image: linear-gradient(135deg, #e6fbff 0%, #8fdcec 55%, #3aa6bf 100%);
    }
    .panel--bathy .panel-status { color: #7fd6e8; }
    .panel--bathy .panel-desc { color: #cfe6ee; }
    .card-tag--bathy {
      background: rgba(232,149,90,0.14);
      color: #f6b77a;
      border: 1px solid rgba(232,149,90,0.40);
    }
    .bathy-res {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .bathy-res span {
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      color: #bfe9f3;
      background: rgba(127,214,232,0.08);
      border: 1px solid rgba(127,214,232,0.25);
    }
    .bathy-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      align-self: flex-start;
      padding: 0.5rem 1rem;
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-decoration: none;
      border-radius: 7px;
      color: #1d1006;
      background: #e8955a;
      border: 1px solid #e8955a;
      transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.25s ease;
    }
    .bathy-btn:hover {
      background: #f2ad7b;
      transform: translateY(-1px);
      box-shadow: 0 0 18px rgba(232,149,90,0.35);
    }

    /* === Jeux complets : cartes compactes, lien étiré sur toute la carte === */
    .complets-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }
    .game-card {
      position: relative;
      display: flex;
      flex-direction: column;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      min-width: 0;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .game-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--card-shadow), 0 0 0 1px var(--accent, var(--gold-dim));
      border-color: var(--accent, var(--gold-dim));
    }
    .game-card--achro { --accent: #c9a227; }
    .game-card--fda { --accent: var(--gold-dim); }
    .game-card--orbique { --accent: #38bdf8; }
    .game-card__banner {
      position: relative;
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .game-card__banner--fda { background: var(--banner-fda); }
    .game-card__banner--fda img {
      position: absolute;
      top: 4%;
      left: 50%;
      height: 92%;
      width: auto;
      transform: translateX(-50%);
      border-radius: 6px;
    }
    .game-card__banner--orbique { background: var(--banner-orbique); }
    .game-card__banner--achro { background: var(--banner-achro); }
    .game-card__glyph {
      font-size: 2.6rem;
      filter: drop-shadow(0 0 12px currentColor);
    }
    .game-card__banner--orbique .game-card__glyph { color: #38bdf8; }
    .achro-gems {
      display: flex;
      gap: 0.7rem;
      align-items: center;
    }
    .achro-gems span {
      width: 18px;
      height: 18px;
      transform: rotate(45deg);
      border-radius: 3px;
      box-shadow: 0 0 14px currentColor;
      background: currentColor;
    }
    .achro-gems span:nth-child(1) { color: #4caf7a; }
    .achro-gems span:nth-child(2) { color: #e8c547; width: 26px; height: 26px; }
    .achro-gems span:nth-child(3) { color: #9b6ee8; }
    .game-card__body {
      padding: 0.85rem 1rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      flex: 1;
    }
    .game-card__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .game-card__title {
      font-family: 'Cinzel', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-strong);
      line-height: 1.2;
    }
    .game-card__link {
      color: inherit;
      text-decoration: none;
    }
    .game-card__link::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    .game-card__desc {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.5;
      flex: 1;
    }
    .game-card__foot {
      display: flex;
      align-items: center;
      gap: 0.4rem 0.8rem;
      flex-wrap: wrap;
    }
    .game-card__sub {
      position: relative;
      z-index: 2;
      font-size: 0.72rem;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      transition: color 0.2s, border-color 0.2s;
    }
    .game-card__sub:hover { color: var(--gold); border-color: var(--gold); }

    /* === Mini-jeux : liste en lignes === */
    .mini-list {
      display: grid;
      grid-auto-rows: 1fr;
      gap: 0.45rem;
    }
    .mini-row {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.55rem 0.8rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      text-decoration: none;
      color: inherit;
      min-width: 0;
      transition: transform 0.2s, border-color 0.2s, background 0.2s;
    }
    .mini-row:hover {
      transform: translateX(3px);
      background: var(--surface2);
      border-color: rgba(129,140,248,0.35);
    }
    .mini-icon {
      font-size: 1.15rem;
      width: 32px; height: 32px;
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: var(--surface2);
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .mini-text {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }
    .mini-title {
      font-family: 'Cinzel', serif;
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text-strong-violet);
    }
    .mini-desc {
      font-size: 0.72rem;
      color: var(--muted);
      line-height: 1.4;
    }

    /* === Boutons Jouer thématiques par jeu === */
    .btn-game {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      flex-shrink: 0;
      padding: 0.4rem 0.85rem;
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border-radius: 7px;
      border: 1px solid transparent;
      background-clip: padding-box;
      transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .btn-game::after { content: '→'; transition: transform 0.2s ease; }
    :is(a, .game-card):hover .btn-game::after { transform: translateX(3px); }
    :is(a, .game-card):hover .btn-game { transform: translateY(-1px); }

    /* Achrogemme · grimoire or et améthyste */
    .btn-game--achro {
      color: #f0d97a;
      background: linear-gradient(135deg, rgba(124,79,208,0.22) 0%, rgba(201,162,39,0.16) 100%);
      border-color: rgba(201,162,39,0.50);
      text-shadow: 0 0 8px rgba(201,162,39,0.30);
    }
    .game-card:hover .btn-game--achro {
      border-color: #e8c547;
      box-shadow: 0 0 18px rgba(124,79,208,0.28), 0 0 10px rgba(201,162,39,0.20);
    }
    [data-theme="light"] .btn-game--achro {
      color: #5a3a8a;
      background: linear-gradient(135deg, rgba(124,79,208,0.12) 0%, rgba(201,162,39,0.14) 100%);
      border-color: rgba(124,79,208,0.45);
      text-shadow: none;
    }

    /* FDA · forge / or / braise */
    .btn-game--fda {
      color: #f5d97a;
      background: linear-gradient(135deg, rgba(212,160,23,0.22), rgba(140,80,20,0.12));
      border-color: rgba(212,160,23,0.50);
      text-shadow: 0 0 8px rgba(212,160,23,0.35);
    }
    .game-card:hover .btn-game--fda {
      border-color: #d4a017;
      box-shadow: 0 0 20px rgba(212,160,23,0.30), inset 0 0 14px rgba(212,160,23,0.10);
    }
    [data-theme="light"] .btn-game--fda {
      color: #6a4808;
      background: linear-gradient(135deg, rgba(212,160,23,0.18), rgba(184,128,15,0.10));
      border-color: rgba(184,128,15,0.55);
      text-shadow: none;
    }

    /* Orbique · cyan luminescent */
    .btn-game--orbique {
      color: #7fdcff;
      background: linear-gradient(135deg, rgba(56,189,248,0.18), rgba(30,100,180,0.10));
      border-color: rgba(56,189,248,0.50);
      text-shadow: 0 0 8px rgba(56,189,248,0.35);
    }
    .game-card:hover .btn-game--orbique {
      border-color: #38bdf8;
      box-shadow: 0 0 20px rgba(56,189,248,0.30), inset 0 0 14px rgba(56,189,248,0.10);
    }
    [data-theme="light"] .btn-game--orbique {
      color: #0c5b8a;
      background: linear-gradient(135deg, rgba(56,189,248,0.16), rgba(56,140,200,0.08));
      border-color: rgba(56,140,200,0.55);
      text-shadow: none;
    }

    /* Aelindra · sable, cuivre, lampe à huile */
    .btn-game--aelindra {
      color: #e8c980;
      background: linear-gradient(135deg, rgba(212,179,112,0.22), rgba(120,80,40,0.12));
      border-color: rgba(212,179,112,0.50);
      text-shadow: 0 0 8px rgba(212,179,112,0.30);
    }
    a:hover .btn-game--aelindra {
      border-color: #d4b370;
      box-shadow: 0 0 18px rgba(212,179,112,0.30);
    }
    [data-theme="light"] .btn-game--aelindra {
      color: #7a5018;
      background: linear-gradient(135deg, rgba(212,179,112,0.20), rgba(160,120,60,0.10));
      border-color: rgba(160,120,60,0.55);
      text-shadow: none;
    }

    /* Zentel · arcane / violet */
    .btn-game--zentel {
      color: #c4a4ff;
      background: linear-gradient(135deg, rgba(124,92,191,0.22), rgba(70,40,140,0.12));
      border-color: rgba(168,124,255,0.50);
      text-shadow: 0 0 8px rgba(168,124,255,0.40);
    }
    a:hover .btn-game--zentel {
      border-color: #a78bfa;
      box-shadow: 0 0 20px rgba(124,92,191,0.32);
    }
    [data-theme="light"] .btn-game--zentel {
      color: #4a2a90;
      background: linear-gradient(135deg, rgba(124,92,191,0.16), rgba(90,60,160,0.08));
      border-color: rgba(106,74,176,0.55);
      text-shadow: none;
    }

    /* EcoSim · feuille / nature */
    .btn-game--ecosim {
      color: #86efac;
      background: linear-gradient(135deg, rgba(74,222,128,0.18), rgba(20,90,40,0.10));
      border-color: rgba(74,222,128,0.50);
      text-shadow: 0 0 8px rgba(74,222,128,0.30);
    }
    a:hover .btn-game--ecosim {
      border-color: #4ade80;
      box-shadow: 0 0 18px rgba(74,222,128,0.30);
    }
    [data-theme="light"] .btn-game--ecosim {
      color: #1e6a35;
      background: linear-gradient(135deg, rgba(74,222,128,0.18), rgba(30,122,58,0.10));
      border-color: rgba(30,122,58,0.55);
      text-shadow: none;
    }

    /* Conway · grille cellulaire monospace */
    .btn-game--conway {
      color: #e8e0d0;
      font-family: 'JetBrains Mono', 'Consolas', monospace;
      letter-spacing: 0.10em;
      background-color: rgba(255,255,255,0.04);
      background-image:
        linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
      background-size: 6px 6px, 6px 6px;
      border-color: rgba(232,224,208,0.35);
    }
    a:hover .btn-game--conway {
      border-color: #e8e0d0;
      box-shadow: 0 0 14px rgba(255,255,255,0.18);
    }
    [data-theme="light"] .btn-game--conway {
      color: #2a1e10;
      background-color: rgba(0,0,0,0.04);
      background-image:
        linear-gradient(rgba(0,0,0,0.10) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,0,0,0.10) 1px, transparent 1px);
      border-color: rgba(0,0,0,0.30);
    }

    /* Eryndor · duel violet × or */
    .btn-game--eryndor {
      color: #f0d97a;
      background: linear-gradient(90deg, rgba(124,79,208,0.25) 0%, rgba(212,160,23,0.22) 100%);
      border-color: rgba(180,130,200,0.50);
      text-shadow: 0 0 8px rgba(212,160,23,0.30);
    }
    a:hover .btn-game--eryndor {
      border-color: #b88be5;
      box-shadow: 0 0 16px rgba(124,79,208,0.30), 0 0 10px rgba(212,160,23,0.20);
    }
    [data-theme="light"] .btn-game--eryndor {
      color: #5a2e90;
      background: linear-gradient(90deg, rgba(124,79,208,0.14) 0%, rgba(184,128,15,0.14) 100%);
      border-color: rgba(124,79,208,0.50);
      text-shadow: none;
    }

    /* === Mise en page tableau de bord 16:9 (desktop) === */
    @media (min-width: 1100px) {
      body { height: 100vh; height: 100dvh; }

      .dash {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-rows: 1.65fr 1fr;
        min-height: 0;
        gap: 1.1rem 1.2rem;
        padding: 1.1rem clamp(1rem, 2vw, 2rem) 1.3rem;
      }
      .zone--une {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: auto 1fr;
      }
      .zone--une > .section-label { grid-column: 1 / -1; }
      .une-grid { display: contents; }
      .panel--strates { grid-column: 1 / 8; }
      .panel--bathy { grid-column: 8 / -1; }
      .zone--complets { grid-column: 1 / 8; }
      .zone--mini { grid-column: 8 / -1; }

      .panel--strates {
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      }
      .panel--strates .shot {
        border-bottom: none;
        border-right: 1px solid rgba(212,160,23,0.28);
      }
      .strates-actions { margin-top: auto; }

      .complets-grid {
        flex: 1;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .game-card__banner { height: auto; flex: 1; min-height: 64px; }
      .game-card__desc {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .mini-list { flex: 1; }
      .mini-desc {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    }

    /* Desktop moins large : plus de place pour le texte de Strates */
    @media (min-width: 1100px) and (max-width: 1599px) {
      .panel--strates { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    }

    /* Desktop peu haut (portables, 1440x810, 1280x720) : tout resserrer pour tenir sans défilement */
    @media (min-width: 1100px) and (max-height: 900px) {
      .topbar { padding-block: 0.5rem; }
      .site-logo { width: 32px; height: 32px; }
      .theme-toggle { width: 30px; height: 30px; }
      .header-title { font-size: 1.3rem; }
      .dash { padding-top: 0.75rem; padding-bottom: 0.9rem; gap: 0.8rem 1.1rem; grid-template-rows: 1.75fr 1fr; }
      .section-label { margin-bottom: 0.45rem; }
      .panel-title { font-size: 1.15rem; }
      .panel-head { gap: 0.3rem 0.6rem; }
      .panel-desc { font-size: 0.8rem; line-height: 1.5; }
      .strates-info { padding: 0.85rem 1.1rem 0.95rem; gap: 0.55rem; }
      .dev-progress-label { margin-bottom: 0.3rem; }
      .age { height: 25px; font-size: 0.7rem; }
      .ages { margin-bottom: 0.3rem; }
      .dev-progress-meta { font-size: 0.72rem; }
      .strates-actions { padding-top: 0.6rem; gap: 0.45rem; }
      .strates-btn { padding: 0.3rem 0.6rem; font-size: 0.68rem; }
      .strates-btn--download { padding: 0.42rem 0.85rem; font-size: 0.74rem; }
      .shot { min-height: 120px; }
      .shot-play { padding: 1.6rem 1rem 0.7rem; font-size: 0.82rem; }
      .bathy-info { padding: 0.8rem 1.1rem 0.95rem; gap: 0.5rem; }
      .bathy-res { display: none; }
      .bathy-btn { padding: 0.42rem 0.9rem; font-size: 0.74rem; }
      .game-card__body { padding: 0.6rem 0.9rem 0.75rem; gap: 0.3rem; }
      .game-card__title { font-size: 0.95rem; }
      .game-card__desc { font-size: 0.74rem; -webkit-line-clamp: 2; }
      .game-card__banner { min-height: 44px; }
      .mini-list { gap: 0.35rem; }
      .mini-row { padding: 0.3rem 0.7rem; gap: 0.65rem; }
      .mini-icon { width: 28px; height: 28px; font-size: 1rem; }
      .mini-title { font-size: 0.8rem; }
      .mini-desc { font-size: 0.68rem; }
      .mini-row .btn-game { padding: 0.3rem 0.7rem; font-size: 0.64rem; }
      .btn-game { padding: 0.32rem 0.75rem; font-size: 0.65rem; }
    }

    /* Écrans larges : un peu plus d'air et de texte */
    @media (min-width: 1600px) {
      .panel-title { font-size: 1.5rem; }
      .panel-desc { font-size: 0.92rem; }
      .age { height: 34px; font-size: 0.8rem; }
      .game-card__title { font-size: 1.15rem; }
      .game-card__desc { font-size: 0.82rem; }
      .mini-title { font-size: 0.92rem; }
      .mini-desc { font-size: 0.76rem; }
    }

    @media (max-width: 640px) {
      .topbar { flex-wrap: wrap; row-gap: 0.4rem; }
      .topbar-credit { margin-left: 0; width: 100%; }
      .header-sub { display: none; }
      .strates-info, .bathy-info { padding: 1rem 1rem 1.1rem; }
      .mini-row .btn-game { display: none; }
    }
  </style>
</head>
<body>

<header class="topbar">
  <div class="header-left">
    <a class="site-logo" href="https://fmenguy.fr" aria-label="Retour sur fmenguy.fr" title="Retour sur fmenguy.fr">
      <img src="/logo.png" alt="FM" width="36" height="36" />
    </a>
    <button class="theme-toggle" id="theme-toggle" aria-label="Changer de thème" title="Changer de thème">
      <svg class="theme-toggle__icon theme-toggle__icon--dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v1m0 16v1m-8-9H3m18 0h-1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707"/>
        <circle cx="12" cy="12" r="4"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
  <div class="topbar-brand">
    <h1 class="header-title">Arcade FM</h1>
    <span class="header-sub">Jeux &amp; expériences web</span>
  </div>
  <p class="topbar-credit">Des projets de <a href="https://fmenguy.fr">François Menguy</a></p>
</header>

<main class="dash">

  <section class="zone zone--une" aria-labelledby="label-une">
    <h2 class="section-label" id="label-une">À la une</h2>
    <div class="une-grid">

      <article class="panel panel--strates">
        <a class="shot" href="https://strates.fmenguy.fr/v2/">
          <img src="/images/strates-v2.webp" width="840" height="616" decoding="async" alt="Capture de la V2 de Strates : l'île en relief vue de dessus avec la nouvelle interface">
          <span class="shot-badge">V2</span>
          <span class="shot-play">
            <span aria-hidden="true">▶</span>
            <span>Jouer à Strates</span>
            <span class="shot-play-arrow" aria-hidden="true">→</span>
          </span>
        </a>

        <div class="strates-info">
          <div class="panel-head">
            <h3 class="panel-title">Strates</h3>
            <span class="card-tag card-tag--strates">Version 2</span>
            <span class="panel-status">En développement actif</span>
          </div>
          <p class="panel-desc">
            Strates est un jeu de dieu voxel (Three.js) où une colonie de colons nommés traverse huit âges de civilisation, de la pierre jusqu'à l'espace, dans la lignée de <a class="inline" href="/fda/">Forge des Âges</a>.
          </p>

          <div class="dev-progress">
            <div class="dev-progress-label">Avancement de la V1</div>
            <div class="ages">
              <div class="age done" title="Version précédente, âge I, Pierre">I</div>
              <div class="age done" title="Version précédente, âge II, Bronze">II</div>
              <div class="age done" title="Version précédente, âge III, Fer et Médiéval">III</div>
              <div class="age done" title="Version précédente, âge IV, Renaissance">IV</div>
              <div class="age wip" title="Version précédente, âge V, Industriel, en chantier">V</div>
              <div class="age" title="Version précédente, âge VI">VI</div>
              <div class="age" title="Version précédente, âge VII">VII</div>
              <div class="age" title="Version précédente, âge VIII">VIII</div>
            </div>
            <p class="dev-progress-meta">
              La V1 reste jouable <a class="inline" href="https://strates.fmenguy.fr/accueil-v1.html">en archive</a>. La V2 repart de l'âge de pierre.
            </p>
          </div>

          <div class="strates-actions">
            <div class="strates-download">
              <a class="strates-btn strates-btn--download" href="https://telechargement.fmenguy.fr/Strates-Setup.exe">
                Télécharger pour Windows <span aria-hidden="true">↓</span>
              </a>
              <span class="strates-install">Windows 10 ou 11, 64 bits · <a class="inline" href="/strates/windows/">Guide d'installation</a></span>
            </div>
            <div class="strates-links">
              <a class="strates-btn strates-btn--changelog" href="https://strates.fmenguy.fr/docs/changelog.html">✓ Changelog</a>
              <a class="strates-btn strates-btn--kanban" href="https://strates.fmenguy.fr/docs/v2/retours/v2-20260925/kanban.html" title="Tableau de suivi des retours et chantiers de la V2">▤ Suivi du chantier</a>
              <a class="strates-btn strates-btn--kanban" href="https://strates.fmenguy.fr/docs/v2/retours/v2-20260925/tableau-de-bord.html" title="Temps, jetons et coût des agents d'IA qui développent Strates, carte par carte">▥ Coulisses IA</a>
              <a class="strates-btn strates-btn--agents" href="/strates/agents/" title="L'arbre interactif des agents d'IA qui développent Strates : orchestrateurs, sous-agents, outils, rejeu animé et coûts">⟁ L'atelier des agents</a>
              <a class="strates-btn strates-btn--poc" href="/strates-poc/" title="Les maquettes de Strates et les choix retenus au fil du temps">◈ Journal des POC</a>
            </div>
          </div>
        </div>
      </article>

      <article class="panel panel--bathy">
        <a class="shot" href="https://bathyreve.fmenguy.fr/">
          <img src="/images/bathyreve.webp" width="1200" height="578" decoding="async" alt="Capture de Bathyrêve : une colonie sous-marine sur pilotis, habitats, ferme d'algues et générateur thermique reliés par des tuyaux">
          <span class="shot-badge">Démo</span>
          <span class="shot-play">
            <span aria-hidden="true">▶</span>
            <span>Plonger dans la démo</span>
            <span class="shot-play-arrow" aria-hidden="true">→</span>
          </span>
        </a>
        <div class="bathy-info">
          <div class="panel-head">
            <h3 class="panel-title">Bathyrêve</h3>
            <span class="card-tag card-tag--bathy">En préparation</span>
            <span class="panel-status">Démo jouable en ligne</span>
          </div>
          <p class="panel-desc">
            Bâtissez une cité au fond de la mer. Habitats, pompes, électrolyseurs et fermes d'algues sur pilotis, reliés par des tuyaux : gardez l'oxygène et la nourriture à flot, puis explorez les abysses vers les cheminées les plus profondes.
          </p>
          <div class="bathy-res" aria-label="Ressources à gérer">
            <span>Oxygène</span><span>Nourriture</span><span>Eau</span><span>Énergie</span><span>Exploration</span>
          </div>
          <a class="bathy-btn" href="https://bathyreve.fmenguy.fr/">Jouer la démo <span aria-hidden="true">→</span></a>
        </div>
