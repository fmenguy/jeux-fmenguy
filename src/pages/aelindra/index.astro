---
import { Game } from '../../games/aelindra/Game';
import '../../games/aelindra/styles/index.css';
import { pwaInfo } from 'virtual:pwa-info';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#07090e" />
  <meta name="mobile-web-app-capable" content="yes" />

  <!-- iOS Safari -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Aelindra" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="apple-touch-startup-image" href="/icons/icon-512.png" />

  <!-- Favicon (utilise le SVG comme favicon vectoriel) -->
  <link rel="icon" type="image/svg+xml" href="/icons/aelindra-icon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />

  <title>Aelindra · Chroniques des Profondeurs</title>

  <!-- Manifest et SW injectés par vite-pwa -->
  {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
</head>
<body>
  <div id="phone">
    <Game client:only="react" />
  </div>

  <script>
    import { registerSW } from 'virtual:pwa-register';
    const updateSW = registerSW({
      onNeedRefresh() {
        // Nouvelle version dispo : on update silencieusement à la prochaine ouverture
        updateSW(true);
      },
      onOfflineReady() {
        console.log('[Aelindra] Prêt pour le mode hors-ligne');
      },
    });
  </script>
</body>
</html>
