---
// Page servie par Cloudflare Pages avec un vrai code 404 pour toute adresse inconnue.
// Elle peut s'afficher sous n'importe quel chemin : toutes les ressources sont en adresse absolue.
const jeux = [
  { nom: 'Strates', href: 'https://strates.fmenguy.fr/v2/', icone: '◈' },
  { nom: 'Bathyrêve', href: 'https://bathyreve.fmenguy.fr/', icone: '◌' },
  { nom: 'Achrogemme', href: '/achrogemme/', icone: '◆' },
  { nom: 'Forge des Âges', href: '/fda/', icone: '⚒' },
  { nom: 'Orbique', href: '/orbique/', icone: '●' },
  { nom: 'Eryndor', href: '/eryndor/', icone: '⚔' },
  { nom: 'EcoSim', href: '/ecosim/ecosystem.html', icone: '❦' },
  { nom: 'Jeu de la Vie', href: '/conway/', icone: '▦' },
  { nom: 'Zentel', href: '/zentel/', icone: '✦' },
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>Page introuvable · Arcade FM</title>
  <script is:inline>
    (function() {
      var t = 'light';
      try { t = localStorage.getItem('theme') || 'light'; } catch (e) {}
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;500;600&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #181b2e;
      --surface:   #232745;
      --surface2:  #2c3155;
      --border:    rgba(255,255,255,0.10);
      --gold:      #d4a017;
      --gold-dim:  #a07810;
      --gold-text: #e3b23c;
      --text:      #e8e0d0;
      --text-strong: #f0e8d8;
      --muted:     #a4a9b6;
      --grid-line: rgba(212,160,23,0.03);
      --card-shadow: 0 14px 34px rgba(0,0,0,0.5);
      --header-title-grad: linear-gradient(135deg, var(--gold) 0%, #f5d060 50%, var(--gold-dim) 100%);
    }

    [data-theme="light"] {
      --bg:        #f5f0eb;
      --surface:   #faf7f4;
      --surface2:  #ede7e0;
      --border:    rgba(120, 80, 40, 0.14);
      --gold:      #b8800f;
      --gold-dim:  #8a5f08;
      --gold-text: #7a5306;
      --text:      #2c1e10;
      --text-strong: #1a1208;
      --muted:     #6b5744;
      --grid-line: rgba(184,128,15,0.05);
      --card-shadow: 0 14px 34px rgba(120,80,40,0.18);
      --header-title-grad: linear-gradient(135deg, #b8800f 0%, #8a5f08 50%, #6a4808 100%);
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      min-height: 100dvh;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      transition: background 0.3s ease, color 0.3s ease;
    }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    a:focus-visible, button:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 3px;
    }

    /* === Barre du haut, identique à l'accueil === */
    .topbar {
      position: relative; z-index: 10;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem clamp(1rem, 2vw, 2rem);
      border-bottom: 1px solid var(--border);
    }
    .header-left { display: flex; align-items: center; gap: 10px; }
    .site-logo {
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      text-decoration: none;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .site-logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 8px; }
    .site-logo:hover { transform: translateY(-2px); }

    .theme-toggle {
      width: 34px; height: 34px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s, background 0.2s;
      flex-shrink: 0;
    }
    .theme-toggle:hover { color: var(--gold); border-color: var(--gold-dim); background: var(--surface2); }
    .theme-toggle__icon--light { display: none; }
    [data-theme="light"] .theme-toggle__icon--dark { display: none; }
    [data-theme="light"] .theme-toggle__icon--light { display: block; }

    .topbar-brand {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      flex-wrap: wrap;
      min-width: 0;
      text-decoration: none;
    }
    .header-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.35rem, 2vw, 1.8rem);
      font-weight: 900;
      letter-spacing: 0.12em;
      background: var(--header-title-grad);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
    }
    .header-sub {
      font-size: 0.7rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    .topbar-credit {
      margin-left: auto;
      font-size: 0.75rem;
      color: var(--muted);
      white-space: nowrap;
    }
    .topbar-credit a { color: var(--gold-text); text-decoration: none; }
    .topbar-credit a:hover { text-decoration: underline; }

    /* === Contenu === */
    .lost {
      position: relative; z-index: 1;
      flex: 1;
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: clamp(1.5rem, 5vh, 3.5rem) 1rem 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    /* Écran de borne d'arcade : toujours sombre, quel que soit le thème */
    .screen {
      position: relative;
      overflow: hidden;
      border-radius: 14px;
      border: 1px solid rgba(212,160,23,0.40);
      background:
        radial-gradient(ellipse at 50% 40%, rgba(212,160,23,0.10) 0%, transparent 60%),
        linear-gradient(180deg, #0b0f22 0%, #131a34 60%, #1c2440 100%);
      box-shadow: var(--card-shadow), inset 0 0 60px rgba(0,0,0,0.55);
      padding: 1rem 1.2rem 2rem;
      text-align: center;
      color: #d6ddef;
    }
    /* Lignes de balayage façon tube cathodique */
    .screen::before {
      content: '';
      position: absolute; inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(180deg,
        rgba(255,255,255,0.035) 0px,
        rgba(255,255,255,0.035) 1px,
        transparent 1px,
        transparent 4px);
    }
    /* Liseré doré en haut, comme le panneau Strates de l'accueil */
    .screen::after {
      content: '';
      position: absolute; inset: 0;
      pointer-events: none;
      background:
        linear-gradient(90deg, transparent, rgba(212,160,23,0.55), transparent) top left / 100% 2px no-repeat,
        linear-gradient(135deg, rgba(212,160,23,0.45) 0 10px, transparent 10px) top left / 20px 20px no-repeat,
        linear-gradient(-45deg, rgba(212,160,23,0.45) 0 10px, transparent 10px) bottom right / 20px 20px no-repeat;
    }

    .hud {
      position: relative;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      color: #c5cbe0;
      margin-bottom: 1.6rem;
    }
    .hud strong { color: #f0c96a; font-weight: 700; }
    .hud-lives { color: #f87171; letter-spacing: 0.2em; }

    .code {
      position: relative;
      font-family: 'Cinzel', serif;
      font-weight: 900;
      font-size: clamp(4.5rem, 20vw, 8rem);
      line-height: 1;
      letter-spacing: 0.08em;
      background-image: linear-gradient(135deg, #f0dca0 0%, #d4a017 55%, #8a6420 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 0 18px rgba(212,160,23,0.30));
    }

    .gameover {
      position: relative;
      margin-top: 0.6rem;
      font-family: 'Cinzel', serif;
      font-size: clamp(1.4rem, 5vw, 2rem);
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #f7d98a;
      text-shadow: 0 0 12px rgba(212,160,23,0.45);
    }

    .continue {
      position: relative;
      margin-top: 1.4rem;
      display: inline-flex;
      align-items: baseline;
      gap: 0.6rem;
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 1rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #e8e0d0;
    }
    .countdown {
      display: inline-block;
      min-width: 1.2ch;
      font-size: 1.5rem;
      font-weight: 700;
      color: #f0c96a;
    }
    .countdown::after { content: '0'; }

    /* Animations : seulement si le visiteur ne demande pas à réduire les mouvements */
    @media (prefers-reduced-motion: no-preference) {
      .code { animation: flicker 6s ease-in-out infinite; }
      .countdown::after { animation: countdown 10s steps(1, end) forwards; }
      .continue-label { animation: pulse 1s ease-in-out 10; }
    }
    @keyframes countdown {
      0%   { content: '9'; }
      10%  { content: '8'; }
      20%  { content: '7'; }
      30%  { content: '6'; }
      40%  { content: '5'; }
      50%  { content: '4'; }
      60%  { content: '3'; }
      70%  { content: '2'; }
      80%  { content: '1'; }
      90%, 100% { content: '0'; }
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    @keyframes flicker {
      0%, 92%, 100% { opacity: 1; transform: none; }
      93% { opacity: 0.75; transform: translateX(-2px); }
      95% { opacity: 1; transform: translateX(2px); }
      97% { opacity: 0.85; transform: none; }
    }

    .message {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }
    .message p {
      font-size: 0.98rem;
      line-height: 1.6;
      color: var(--text);
      max-width: 46ch;
    }
    .message .requested {
      font-size: 0.8rem;
      color: var(--muted);
      word-break: break-all;
    }
    .requested code {
      font-family: 'Consolas', 'Courier New', monospace;
      color: var(--text-strong);
    }

    .btn-home {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.75rem 1.4rem;
      font-family: 'Cinzel', serif;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-decoration: none;
      border-radius: 9px;
      color: #1a1206;
      background: linear-gradient(135deg, #f6dfa4 0%, #d4a017 100%);
      border: 1px solid #d4a017;
      box-shadow: 0 2px 14px rgba(212,160,23,0.35);
      transition: transform 0.2s ease, box-shadow 0.25s ease;
    }
    .btn-home:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 22px rgba(212,160,23,0.50);
    }
    .btn-home span[aria-hidden] { transition: transform 0.2s ease; }
    .btn-home:hover span[aria-hidden] { transform: translateX(3px); }

    .section-label {
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.8rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .games {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0.5rem;
    }
    .games a {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 0.8rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      text-decoration: none;
      color: var(--text-strong);
      font-family: 'Cinzel', serif;
      font-size: 0.85rem;
      font-weight: 700;
      min-height: 44px;
      transition: transform 0.2s, border-color 0.2s, background 0.2s;
    }
    .games a:hover {
      transform: translateY(-2px);
      background: var(--surface2);
      border-color: var(--gold-dim);
    }
    .games-icon {
      width: 26px; height: 26px;
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      color: var(--gold-text);
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 7px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition: none !important; }
    }

    @media (max-width: 640px) {
      .topbar { flex-wrap: wrap; row-gap: 0.4rem; }
      .topbar-credit { margin-left: 0; width: 100%; }
      .header-sub { display: none; }
      .hud { font-size: 0.7rem; letter-spacing: 0.06em; }
      .gameover { letter-spacing: 0.18em; }
    }
  </style>
</head>
<body>

<header class="topbar">
  <div class="header-left">
    <a class="site-logo" href="https://fmenguy.fr" aria-label="Retour sur fmenguy.fr" title="Retour sur fmenguy.fr">
      <img src="/logo.png" alt="FM" width="36" height="36" />
    </a>
    <button class="theme-toggle" id="theme-toggle" aria-label="Changer de thème" title="Changer de thème">
      <svg class="theme-toggle__icon theme-toggle__icon--dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v1m0 16v1m-8-9H3m18 0h-1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707"/>
        <circle cx="12" cy="12" r="4"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
  <a class="topbar-brand" href="/">
    <span class="header-title">Arcade FM</span>
    <span class="header-sub">Jeux &amp; expériences web</span>
  </a>
  <p class="topbar-credit">Des projets de <a href="https://fmenguy.fr">François Menguy</a></p>
</header>

<main class="lost">

  <section class="screen" aria-labelledby="titre-404">
    <div class="hud" aria-hidden="true">
      <span>SCORE <strong>000404</strong></span>
      <span>VIES <span class="hud-lives">♡♡♡</span></span>
    </div>
    <p class="code" aria-hidden="true">404</p>
    <h1 class="gameover" id="titre-404">Game over<span class="sr-only"> : page introuvable (erreur 404)</span></h1>
    <p class="continue" aria-hidden="true">
      <span class="continue-label">Continuer ?</span>
      <span class="countdown"></span>
    </p>
  </section>

  <div class="message">
    <p>Cette page n'existe pas, ou elle a quitté la partie. L'adresse est peut-être mal saisie, ou le jeu a déménagé.</p>
    <p class="requested" id="requested" hidden>Adresse demandée : <code id="requested-path"></code></p>
    <a class="btn-home" href="/">Continuer : retour à l'Arcade <span aria-hidden="true">→</span></a>
  </div>

  <nav aria-labelledby="label-jeux">
    <h2 class="section-label" id="label-jeux">Ou lancez directement une partie</h2>
    <ul class="games">
      {jeux.map((jeu) => (
        <li>
          <a href={jeu.href}>
            <span class="games-icon" aria-hidden="true">{jeu.icone}</span>
            <span>{jeu.nom}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

</main>

<script is:inline>
  (function() {
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function() {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    }
    var path = window.location.pathname;
    if (path && path !== '/' && path !== '/404' && path !== '/404.html') {
      var box = document.getElementById('requested');
      var code = document.getElementById('requested-path');
      if (box && code) {
        var shown = path;
        try { shown = decodeURIComponent(path); } catch (e) {}
        code.textContent = shown;
        box.hidden = false;
      }
    }
  })();
</script>

</body>
</html>
